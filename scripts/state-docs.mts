// Generates docs/STATE_MACHINES.md from lib/state/machines.ts.
//   pnpm state:docs          write the file
//   pnpm state:docs --check  exit 1 if the file is stale (used by tests)
import { readFileSync, writeFileSync } from "node:fs"
import { MACHINES } from "../lib/state/machines.ts"

export function renderStateDocs(): string {
  const out: string[] = [
    "# State machines",
    "",
    "<!-- Generated by `pnpm state:docs` from lib/state/machines.ts. Do not edit by hand. -->",
    "",
    "Every `status` column in Cyreax DM. Change a machine in `lib/state/machines.ts`,",
    "run `pnpm state:docs`, and keep the SQL CHECK constraint in step (tests enforce both).",
    "Terminal states have no outgoing arrows.",
    "",
  ]
  for (const [name, m] of Object.entries(MACHINES)) {
    const t = m.transitions as Record<string, readonly string[]>
    const terminal = Object.keys(t).filter((s) => t[s].length === 0)
    out.push(`## ${name} — \`${m.table}.${m.column}\``, "")
    out.push(`Initial: \`${m.initial}\`. Terminal: ${terminal.length ? terminal.map((s) => `\`${s}\``).join(", ") : "none"}.`, "")
    out.push(`Written by: ${m.writers.map((w) => `\`${w}\``).join(", ")}`, "")
    out.push("```mermaid", "stateDiagram-v2", `  [*] --> ${m.initial}`)
    for (const [from, tos] of Object.entries(t)) for (const to of tos) out.push(`  ${from} --> ${to}`)
    for (const s of terminal) out.push(`  ${s} --> [*]`)
    out.push("```", "")
  }
  return out.join("\n")
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const path = "docs/STATE_MACHINES.md"
  const next = renderStateDocs()
  if (process.argv.includes("--check")) {
    const current = (() => { try { return readFileSync(path, "utf8") } catch { return "" } })()
    if (current !== next) { console.error(`${path} is stale. Run: pnpm state:docs`); process.exit(1) }
  } else {
    writeFileSync(path, next)
    console.log(`wrote ${path}`)
  }
}
