# =============================================================================
# Cyreax DM - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Required variables are marked with [REQUIRED], optional with [OPTIONAL].
# =============================================================================

# --- Supabase ---
# [REQUIRED] Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# [REQUIRED] Your Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# [REQUIRED] Your Supabase service role key (server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- AI / LLM Providers ---
# [REQUIRED] Groq API key for AI features (auto-reply, analytics, copy suggestions, etc.)
# Get one free at: https://console.groq.com/keys
# Historical commits of this public repo contained live Groq keys. Those keys
# are not in the current tree, but they are still in git history. Revoke them
# in the Groq console and use a newly issued key here. Do not paste a real key
# into this example file.
GROQ_API_KEY=your_groq_api_key
# [OPTIONAL] Gemini API key (fallback provider for AI features)
GEMINI_API_KEY=your_gemini_api_key
# [OPTIONAL] OpenRouter API key (secondary fallback for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key
# [OPTIONAL] Anthropic API key — enables Anthropic (Claude) BYOK models
ANTHROPIC_API_KEY=your_anthropic_api_key
# [OPTIONAL] OpenAI API key — enables OpenAI (GPT) BYOK models
OPENAI_API_KEY=your_openai_api_key

# --- Instagram / Meta ---
# [REQUIRED] Instagram/Meta App ID (from Meta Developer Dashboard).
# /api/instagram/auth and /api/instagram/callback both read INSTAGRAM_APP_ID
# first, then NEXT_PUBLIC_INSTAGRAM_APP_ID. Set them to the same App ID.
INSTAGRAM_APP_ID=your_instagram_app_id
# [REQUIRED] Same App ID, exposed to the browser for the Facebook JS SDK fallback.
NEXT_PUBLIC_INSTAGRAM_APP_ID=your_instagram_app_id
# [REQUIRED] Instagram/Meta App Secret
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# [OPTIONAL] Legacy alias for app secret (falls back to INSTAGRAM_APP_SECRET)
META_APP_SECRET=
# [OPTIONAL] Custom Instagram redirect URI (defaults to {APP_URL}/api/instagram/callback)
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=
# [OPTIONAL] Instagram webhook verify token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# --- Facebook ---
# [OPTIONAL] Facebook App ID (falls back to INSTAGRAM_APP_ID)
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
# [OPTIONAL] Facebook App Secret (falls back to META_APP_SECRET)
FACEBOOK_APP_SECRET=your_facebook_app_secret
# [OPTIONAL] Facebook redirect URI (defaults to {APP_URL}/api/facebook/callback)
NEXT_PUBLIC_FACEBOOK_REDIRECT_URI=
# [OPTIONAL] Facebook webhook verify token
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_facebook_webhook_verify_token

# --- WhatsApp ---
# [OPTIONAL] WhatsApp webhook verify token (falls back to INSTAGRAM_WEBHOOK_VERIFY_TOKEN)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
# [OPTIONAL] Embedded Signup configuration id. Without it, connect a number
# with a phone number id and a system-user token in Connected Platforms.
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# --- TikTok Business Messaging ---
# Leave the flags unset until TikTok approves the app. See docs/phase4-channels.md.
# [OPTIONAL] TikTok app id (client key) and secret
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# [OPTIONAL] Defaults to {NEXT_PUBLIC_APP_URL}/api/tiktok/callback
TIKTOK_REDIRECT_URI=
# [OPTIONAL] Master switch. Must be the string true after the Accounts API
# form and the Business Messaging review. Apply without the US for MENA.
TIKTOK_MESSAGING_ENABLED=
# [OPTIONAL] Set to false to disable Comment-to-Message everywhere.
# true only applies when the Business Account region is not stored.
# VN, ID, and TH turn Comment-to-Message on by themselves.
TIKTOK_COMMENT_TO_DM_ENABLED=
# [OPTIONAL] Set to true only after TikTok's US data security review.
# US_REVIEW_APPROVED=true is accepted as the same switch.
TIKTOK_US_REVIEW_APPROVED=

# --- Telegram ---
# (No env vars needed — bots are configured per-account in the database)

# --- App & Brand ---
# [REQUIRED] Your production app URL (e.g. https://<your-domain>)
NEXT_PUBLIC_APP_URL=https://<your-domain>
# [OPTIONAL] Public support email (shown in help/contact links; hide if unset)
NEXT_PUBLIC_SUPPORT_EMAIL=
# [OPTIONAL] Billing support email
NEXT_PUBLIC_BILLING_EMAIL=
# [OPTIONAL] Transactional sender address
EMAIL_FROM_ADDRESS=
# [OPTIONAL] Brand social links (rendered only if set)
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=


# --- Security ---
# [REQUIRED] Secret for encrypting access tokens and BYOK API keys at rest.
# At least 16 characters. Generate one with: openssl rand -base64 32
# There is no fallback. If this is missing, encryption and decryption throw.
# Rotating it makes existing ciphertext unreadable, so keep a backup of the value.
BYOK_ENCRYPTION_SECRET=your_byok_encryption_secret
# [OPTIONAL] Disable webhook signature verification (ONLY for local dev — never in production).
# When true, this skips signature checks on the Instagram, Facebook, WhatsApp, and TikTok webhooks.
DISABLE_WEBHOOK_SIGNATURE_CHECK=false

# --- IP Quality Score ---
# [OPTIONAL] IPQS API key for fraud detection during Instagram connection
IPQS_API_KEY=your_ipqs_api_key

# --- Cron ---
# [REQUIRED] Bearer secret for /api/cron/* (Vercel sends it as Authorization).
# Cron routes return 503 when this is unset. Generate one with: openssl rand -base64 32
CRON_SECRET=your_cron_secret

# --- Phase 6 differentiators ---
# [OPTIONAL] OpenAI key. When set, knowledge-base chunks use text-embedding-3-small
# at 384 dimensions. When unset, Helixa uses a local hash embedding. Do not mix the
# two in one workspace: re-save the knowledge base after you add or remove the key.
# Paymob, Stripe, Shopify, WooCommerce, Google Sheets, and HubSpot credentials are
# entered per workspace in the dashboard and stored encrypted with BYOK_ENCRYPTION_SECRET.
# They are not environment variables.

# --- Phase 7 launch ---
# [OPTIONAL] Sentry DSN. When set, unhandled errors and the root error boundary
# POST a Sentry envelope. No Sentry SDK is bundled. Leave unset to log only.
SENTRY_DSN=
# [OPTIONAL] Same DSN, readable in the browser error boundary.
NEXT_PUBLIC_SENTRY_DSN=
# [OPTIONAL] Platform billing through Paymob. Client DM checkout still uses
# the encrypted workspace keys, not these variables.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC=
# [OPTIONAL] Tap secret for Helixa subscription checkout and the Tap webhook
# when a workspace has not saved its own Tap key.
TAP_SECRET_KEY=
# [OPTIONAL] Account email for scripts/seed-demo.mts. The account must already exist.
SEED_ACCOUNT_EMAIL=
# [OPTIONAL] Set to 1 to keep the account's current plan when seeding.
SEED_KEEP_PLAN=
